# Splyntra Observability, Security & Governance
SPLYNTRA_API_KEY=splyntra_dev_key
SPLYNTRA_ENDPOINT=http://localhost:4318
SPLYNTRA_PROJECT=browser-use-agent
SPLYNTRA_ENVIRONMENT=production
SPLYNTRA_GUARD=monitor

# Model Providers (Groq, OpenRouter, or OpenAI)
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
